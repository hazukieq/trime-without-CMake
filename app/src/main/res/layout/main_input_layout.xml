<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_input"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include android:id="@+id/candidate_view" layout="@layout/candidate_bar" />

    <FrameLayout
        android:id="@+id/input_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.hazukieq.hkrime.ime.keyboard.KeyboardView
            android:id="@+id/main_keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 展開面板：只覆蓋鍵盤區，候選欄（第一行）保持可見。
             面板根直接就是橫向 LinearLayout（舊版外面多包一層 FrameLayout）。 -->
        <LinearLayout
            android:id="@+id/candidate_panel_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/panel_surface_fallback"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- 左側：拼音音節組（自切音節，僅顯示/導航），高度貫通到底 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/candidate_group_list"
                android:layout_width="88dp"
                android:layout_height="match_parent"
                android:background="@color/panel_group_bg_fallback"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/candidate_panel"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingStart="14dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <!-- 底部一條：放退格鍵，候選區不再被它遮住（用戶 2026-11-10）
                     不用 FrameLayout 包單個 TextView：直接 layout_gravity=end 即可 -->
                <TextView
                    android:id="@+id/panel_backspace"
                    android:layout_width="60dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/panel_backspace_bg"
                    android:clickable="true"
                    android:contentDescription="@string/backspace"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⌫"
                    android:textColor="@color/panel_backspace_ink_fallback"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>

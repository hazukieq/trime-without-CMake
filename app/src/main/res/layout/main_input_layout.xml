<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_input"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include android:id="@+id/candidate_view" layout="@layout/candidate_bar" />

    <FrameLayout
        android:id="@+id/input_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.hazukieq.hkrime.ime.keyboard.KeyboardView
            android:id="@+id/main_keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 展開面板：只覆蓋鍵盤區，候選欄（第一行）保持可見 -->
        <FrameLayout
            android:id="@+id/candidate_panel_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFFFF"
            android:visibility="gone">

            <!-- 橫向排布：左側音節列整列貫通到底（含退格鍵那一行的高度）；
                 右側 = 候選網格 + 底部退格條（退格條背景與候選區一致，左列不停斷）。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- 左側：拼音音節組（自切音節，僅顯示/導航），高度貫通到底 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/candidate_group_list"
                    android:layout_width="88dp"
                    android:layout_height="match_parent"
                    android:background="#FFEDF0F2"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:clipToPadding="false" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/candidate_panel"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:paddingStart="14dp"
                        android:paddingEnd="2dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />

                    <!-- 底部一條：放退格鍵，候選區不再被它遮住（用戶 2026-11-10） -->
                    <!-- 不加底色：透明即透出面板根底色（= 右侧展开面板区颜色，隨主題鍵盤底色變） -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp">

                    <TextView
                        android:id="@+id/panel_backspace"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/panel_backspace_bg"
                        android:clickable="true"
                        android:contentDescription="退格"
                        android:elevation="2dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="⌫"
                        android:textColor="#FF3C4043"
                        android:textSize="22sp" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

</LinearLayout>

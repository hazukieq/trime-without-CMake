<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/symbol_panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- 上半区：左 4×4 符号网格 + 右侧功能列（返回 / 上翻 / 下翻 / 锁定） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/symbol_grid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/symbol_action_col"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/symbol_btn_back"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="返回"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/symbol_btn_up"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="上一页"
                android:focusable="true"
                android:scaleType="center"
                android:src="@drawable/ic_symbol_up" />

            <ImageView
                android:id="@+id/symbol_btn_down"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="下一页"
                android:focusable="true"
                android:scaleType="center"
                android:src="@drawable/ic_symbol_down" />

            <ImageView
                android:id="@+id/symbol_btn_lock"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="锁定面板"
                android:focusable="true"
                android:scaleType="center"
                android:src="@drawable/ic_symbol_lock_open" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/symbol_divider_h"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <!-- 底部：横向可滚动分类标签栏（由 /sdcard/hkrime/symbols/*.txt 动态生成） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/symbol_tabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:overScrollMode="never"
        android:scrollbars="none" />

</LinearLayout>
